# Supabase 프로젝트 설정 > API 에서 값을 복사해서 .env.local 파일을 만들고 붙여넣으세요.
# .env.local은 git에 커밋하지 마세요.

NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# scripts/seed-supabase.ts 를 로컬에서 실행할 때만 필요 (앱 코드에는 쓰이지 않음).
# Project Settings > API > service_role — 절대 커밋/공유 금지.
# SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=eyJxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
